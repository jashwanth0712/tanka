# mock | arkiv  — production MUST be "arkiv"
NEXT_PUBLIC_DATA_SOURCE=mock
# Default Arkiv RPC (Tiramisu testnet). Users can switch at runtime from the status pill.
NEXT_PUBLIC_ARKIV_RPC_URL=
# Block explorer base URL (no trailing slash)
NEXT_PUBLIC_ARKIV_EXPLORER_URL=
# Never put private keys in NEXT_PUBLIC_* vars. Seed-script keys live only in .env.local, read by /cli.
